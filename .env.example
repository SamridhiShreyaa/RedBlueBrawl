# Neo4j connection settings for RedBlueBrawl.
# Copy to `.env` and adjust as needed. Real environment variables override
# these. The defaults below match docker-compose.yml so `docker compose up`
# works out of the box.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# Optional: path to the IAM dataset used by the loader scripts.
# IAM_DATASET_PATH=data/iam_dataset.json

# Risk scorer used by the pipeline: "signature" (default) or "reachability".
# "reachability" requires trust-edge data on the graph and will fail loudly if
# none is present, so it is opt-in until real IAM/trust-policy ingestion lands.
# RISK_SCORER_METHOD=signature
